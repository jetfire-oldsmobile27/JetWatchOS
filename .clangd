CompileFlags:
  CompilationDatabase: .
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -freorder-blocks
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
    - -mtext-section-literals
    - -fstack-protector
    - -fstack-protector-strong
    - -Werror=*
    - -MMD
    - --target=*                       # ← ДОБАВИТЬ ЭТУ СТРОКУ
  Add:
    - -Wno-unknown-warning-option
    - -Wno-gnu-zero-variadic-macro-arguments
    - -Wno-macro-redefined
    - -Wno-unknown-attributes
    - -Wno-invalid-pp-token
    - -ferror-limit=0
    - --query-driver=/home/jetfire27/.platformio/packages/toolchain-xtensa-esp-elf/bin/xtensa-esp32s3-elf-*

Index:
  Background: Build